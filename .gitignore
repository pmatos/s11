# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Test binaries
binaries/

# e2e outcome-case fixtures built by build_tests.sh (gcc -m32)
tests/e2e/fixtures/x86_32/

# IDE-specific files
.vscode/
.claude/settings.local.json
.claude/worktrees/

# Python bytecode (scripts/)
__pycache__/

# cargo-mutants output
mutants.out/
mutants.out.old/

.ultraplan/
.clawpatch/
.claude/

# Workspace-local planning-to-implementation handoff
/PLAN.md

# criterion benchmark output and JSONL accumulator (issue #70)
benches/results/
